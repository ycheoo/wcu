[Unit]
Description=Start Claude usage windows on schedule for %i

[Timer]
OnCalendar=*-*-* 07:30:00 Asia/Tokyo
OnCalendar=*-*-* 12:31:00 Asia/Tokyo
OnCalendar=*-*-* 17:32:00 Asia/Tokyo
OnCalendar=*-*-* 22:33:00 Asia/Tokyo
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=wake-claude-up@%i.service

[Install]
WantedBy=timers.target

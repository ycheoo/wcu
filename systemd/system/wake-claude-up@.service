[Unit]
Description=Send a minimal scheduled prompt to Claude Code for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
Environment="PATH=/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/etc/wake-claude-up/%i.env
WorkingDirectory=~
ExecStart=/usr/bin/env claude --safe-mode -p --model haiku --tools "" --no-session-persistence "Reply with only OK."
TimeoutStartSec=5min

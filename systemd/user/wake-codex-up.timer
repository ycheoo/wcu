[Unit]
Description=Start Codex usage windows on schedule

[Timer]
OnCalendar=*-*-* 07:30:00 Asia/Tokyo
OnCalendar=*-*-* 12:31:00 Asia/Tokyo
OnCalendar=*-*-* 17:32:00 Asia/Tokyo
OnCalendar=*-*-* 22:33:00 Asia/Tokyo
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=wake-codex-up.service

[Install]
WantedBy=timers.target

[Unit]
Description=Start Claude usage windows on schedule

[Timer]
OnCalendar=*-*-* 00:12:00 Asia/Tokyo
OnCalendar=*-*-* 09:00:00 Asia/Tokyo
OnCalendar=*-*-* 14:02:00 Asia/Tokyo
OnCalendar=*-*-* 19:07:00 Asia/Tokyo
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=wake-claude-up.service

[Install]
WantedBy=timers.target
